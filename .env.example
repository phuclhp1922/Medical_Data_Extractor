# Copy to .env and fill in. .env is gitignored; this file is not.
# Never put real keys in this file.

# --- Extractor / grader (the high-volume roles) ---
OPENAI_API_KEY=
CURATOR_MODEL=

# --- Independent judge, used only on the ~30-case calibration subset ---
# MUST be a different model family from CURATOR_MODEL. The same model
# extracting, grading, and auditing its own output is self-enhancement bias,
# and measuring it against itself proves nothing. See PLAN.md section 2.6.
JUDGE_API_KEY=
JUDGE_MODEL=

# --- Local corpus (not redistributable; keep it outside the repo) ---
# Directory of MinerU output, one subdirectory per case, each containing auto/.
CURATOR_CORPUS_DIR=
