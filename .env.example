# Copy to .env and fill in. .env is gitignored; this file is not.
# Never put real keys in this file.

# --- Extractor / grader (the high-volume roles) ---
OPENAI_API_KEY=
CURATOR_MODEL=

# --- Independent judge, used only on the ~30-case calibration subset ---
# MUST be a different model family from CURATOR_MODEL. The same model
# extracting, grading, and auditing its own output is self-enhancement bias,
# and measuring it against itself proves nothing. See PLAN.md section 2.6.
JUDGE_API_KEY=
JUDGE_MODEL=
# The editor's sampling temperature. `none` omits it, which reasoning models require.
JUDGE_TEMPERATURE=
# Endpoint for the judge's vendor. Leave blank for OpenAI. NOTE: the vendor must serve the
# *Responses* API - parsing.py reads that response shape, not Chat Completions. Check before
# committing to a judge vendor.
JUDGE_BASE_URL=

# Sampling temperature for the curator roles (extractor, grader). Low on purpose: this is
# extraction, not writing. The editor has its own setting, JUDGE_TEMPERATURE, because the two
# roles are different models: one may reject the parameter while the other needs it.
# Set it to `none` to omit the parameter entirely: reasoning models reject it outright, and
# leaving this blank is not the same thing - blank means "use the default below".
CURATOR_TEMPERATURE=0.1
# Re-extractions after an editor verdict raises concerns. 3 means four extract passes.
CURATOR_MAX_REFINES=3
# Image fidelity sent with every figure: auto, low or high. `low` is markedly cheaper and is the
# first thing to turn down if a full run costs too much - a figure is sent on every extract and
# every review, so one case can send each image eight times.
CURATOR_IMAGE_DETAIL=auto

# --- Rate limiting. Turn these first if the run is dying on 429s ---
# Minimum seconds between requests on one API key. Raise it to go gentler.
CURATOR_PAUSE_SECONDS=5.0
# Times the SDK retries a failed request itself, with its own backoff. 0 disables retrying,
# which is what cassette replay wants.
CURATOR_REQUEST_RETRIES=2

# --- Local corpus (not redistributable; keep it outside the repo) ---
# Directory of MinerU output, one subdirectory per case, each containing auto/.
CURATOR_CORPUS_DIR=
